APP_NAME="SIMARC-Arsip Record Center"
APP_URL=http://localhost:8080
APP_PORT=8080
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# ── Aplikasi Desktop (opsional) ──
# Mode jendela saat SIMARC dibuka sebagai aplikasi desktop:
#   normal (default) | maximized | fullscreen | kiosk
SIMARC_WINDOW=normal

# ── Mode KLIEN (multi-komputer) ──
# Isi dengan alamat server pusat agar komputer ini TIDAK menjalankan
# server/database lokal, melainkan memakai server pusat (satu database +
# satu penyimpanan berkas untuk semua komputer).
#   Contoh: SIMARC_SERVER_URL=http://192.168.1.10:8080
# Kosongkan untuk menjalankan server lokal (default).
SIMARC_SERVER_URL=

# ─────────────────────────────────────────────────────────────────────────
# SESSION_KEY — Wajib diisi di production (gunakan 32+ karakter random).
#                  Contoh: openssl rand -hex 32
#                  Tanpa SESSION_KEY, server akan otomatis membuat sesi
#                  transient (cookies tidak akan valid antar-deploy di Vercel).
# ─────────────────────────────────────────────────────────────────────────
SESSION_KEY=

# ══════════════════════════════════════════════════════════════════
#  MYSQL / MARIADB — Database aplikasi.
#  Lokal: install MySQL/MariaDB lalu buat database & user (mis. simarc).
#  JANGAN pernah commit kredensial asli ke git!
#  Simpan kredensial di file .env (gitignored) atau Vercel env vars.
# ══════════════════════════════════════════════════════════════════
# Option 1: Aiven connection string (full DSN, tls=true sudah built-in)
#DATABASE_URL=mysql://avnadmin:password@host:19160/defaultdb?ssl-mode=REQUIRED
#
# Option 2: Field terpisah (direkomendasikan — cocok untuk MySQL lokal)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simarc
DB_USERNAME=simarc
DB_PASSWORD=simarc

# Mode TLS koneksi MySQL: preferred (default) | skip-verify | true | false
#   preferred   — pakai TLS jika server mendukung, fallback tanpa TLS (aman untuk Aiven & MySQL lokal)
#   skip-verify — selalu TLS tanpa verifikasi sertifikat (Aiven memakai CA self-signed)
#   true        — selalu TLS dengan verifikasi sertifikat penuh
#   false       — tanpa TLS
DB_TLS=preferred

# ══════════════════════════════════════════════════════════════════
#  SINKRONISASI MULTI-KOMPUTER (offline-first) — opsional
#
#  Setiap komputer menjalankan DATABASE SENDIRI (dari DB_* di atas) sehingga
#  aplikasi tetap jalan tanpa jaringan. Bila salah satu database dijadikan
#  "hub" (titik temu), perubahan tiap komputer digabung dua arah saat hub
#  terjangkau. Lihat docs/OFFLINE-SYNC.md.
# ══════════════════════════════════════════════════════════════════
# Aktifkan sinkronisasi otomatis di latar belakang (true/false).
SYNC_ENABLED=false
# Identitas unik komputer ini. WAJIB berbeda di setiap komputer.
# Kosongkan untuk memakai nama komputer otomatis.
SYNC_NODE_ID=
# Seberapa sering mencoba menyambung ke hub (menit).
SYNC_INTERVAL_MINUTES=15

# Alamat database HUB (titik temu) — satu untuk semua komputer.
# Boleh komputer server di kantor (alamat LAN) atau database cloud (Aiven).
# Kosongkan bila komputer ini adalah hub dan tidak menarik dari siapa pun.
SYNC_HUB_DB_HOST=
SYNC_HUB_DB_PORT=3306
SYNC_HUB_DB_NAME=
SYNC_HUB_DB_USER=
SYNC_HUB_DB_PASS=
# preferred (LAN lokal) | required (cloud/Aiven) | disabled
SYNC_HUB_DB_TLS=preferred

# ── Google Drive Backup (opsional) ──
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_FOLDER_ID=

# ══════════════════════════════════════════════════════════════════
#  VERCEL DEPLOYMENT — Set environment variables ini di Vercel Dashboard
# ══════════════════════════════════════════════════════════════════
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# SESSION_KEY=<32+ karakter random>
# APP_URL=https://your-app.vercel.app
# APP_DEBUG=false
# GOOGLE_DRIVE_CLIENT_ID (opsional)
