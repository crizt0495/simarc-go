# ════════════════════════════════════════════════════════════════
#  SIMARC — APLIKASI DESKTOP (offline-first)
#  Salin file ini menjadi `.env` di samping aplikasi, lalu sesuaikan.
#  Bisa juga diubah lewat UI: menu Pengaturan → Simpan.
# ════════════════════════════════════════════════════════════════

APP_NAME="SIMARC — Arsip Record Center"
APP_TIMEZONE=Asia/Jakarta
APP_DEBUG=false

# ── Jendela aplikasi (masuk efek saat dibuka lagi) ──
# normal | maximized | fullscreen (default) | kiosk
SIMARC_WINDOW=fullscreen

# ── Database lokal (MySQL / MariaDB) ────────────────────────────
# Tiap komputer memakai database sendiri sehingga aplikasi tetap
# jalan tanpa jaringan. Migrasi skema dijalankan otomatis.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simarc
DB_USERNAME=simarc
DB_PASSWORD=simarc
# preferred | required | verify-full | disabled
DB_TLS=preferred

# ── Sinkronisasi multi-komputer (opsional) ──────────────────────
# SYNC_ENABLED=true memerlukan SYNC_HUB_URL (basis URL aplikasi hub).
SYNC_ENABLED=false
SYNC_NODE_ID=
SYNC_INTERVAL_MINUTES=15
SYNC_HUB_URL=
SYNC_HUB_TOKEN=

# ── DATABASE_URL (opsional, untuk cloud MySQL seperti Aiven) ────
# Menimpa nilai DB_* bila diisi.
#DATABASE_URL=mysql://user:pass@host:3306/db?ssl-mode=REQUIRED

# ── Kunci sesi internal (produksi: isi 32+ karakter acak) ───────
# openssl rand -hex 32
SESSION_KEY=
