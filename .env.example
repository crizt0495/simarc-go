APP_NAME="SIMARC-Arsip Record Center"
APP_URL=http://localhost:8080
APP_PORT=8080
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# ─────────────────────────────────────────────────────────────────────────
# SESSION_KEY — Wajib diisi di production (gunakan 32+ karakter random).
#                  Contoh: openssl rand -hex 32
#                  Tanpa SESSION_KEY, server akan otomatis membuat sesi
#                  transient (cookies tidak akan valid antar-deploy di Vercel).
# ─────────────────────────────────────────────────────────────────────────
SESSION_KEY=

# ══════════════════════════════════════════════════════════════════
#  MYSQL / MARIADB — Database aplikasi.
#  Lokal: install MySQL/MariaDB lalu buat database & user (mis. simarc).
#  JANGAN pernah commit kredensial asli ke git!
#  Simpan kredensial di file .env (gitignored) atau Vercel env vars.
# ══════════════════════════════════════════════════════════════════
# Option 1: Aiven connection string (full DSN, tls=true sudah built-in)
#DATABASE_URL=mysql://avnadmin:password@host:19160/defaultdb?ssl-mode=REQUIRED
#
# Option 2: Field terpisah (direkomendasikan — cocok untuk MySQL lokal)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simarc
DB_USERNAME=simarc
DB_PASSWORD=simarc

# Mode TLS koneksi MySQL: preferred (default) | skip-verify | true | false
#   preferred   — pakai TLS jika server mendukung, fallback tanpa TLS (aman untuk Aiven & MySQL lokal)
#   skip-verify — selalu TLS tanpa verifikasi sertifikat (Aiven memakai CA self-signed)
#   true        — selalu TLS dengan verifikasi sertifikat penuh
#   false       — tanpa TLS
DB_TLS=preferred

# ══════════════════════════════════════════════════════════════════
#  AIVEN — Backup offsite / Disaster-Recovery target (opsional).
#  Dipakai oleh scripts/simarc-backup.sh: tiap malam dump lokal diimpor
#  ke database Aiven ini (DROP+CREATE+import → salinan selalu utuh).
#  Aktif otomatis bila AIVEN_HOST & AIVEN_PASSWORD terisi.
#  TLS: skrip memakai --ssl (enkripsi). CA self-signed Aiven dilayani
#  tanpa verifikasi host; untuk verifikasi penuh simpan ca.pem dari
#  konsol Aiven lalu ubah blok AIVEN di skrip menjadi --ssl-ca.
# ══════════════════════════════════════════════════════════════════
AIVEN_HOST=
AIVEN_PORT=19160
AIVEN_USERNAME=avnadmin
AIVEN_PASSWORD=
AIVEN_DATABASE=simarc_db

# ── Google Drive Backup (opsional) ──
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_FOLDER_ID=

# ══════════════════════════════════════════════════════════════════
#  VERCEL DEPLOYMENT — Set environment variables ini di Vercel Dashboard
# ══════════════════════════════════════════════════════════════════
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# SESSION_KEY=<32+ karakter random>
# APP_URL=https://your-app.vercel.app
# APP_DEBUG=false
# GOOGLE_DRIVE_CLIENT_ID (opsional)
