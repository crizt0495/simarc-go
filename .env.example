APP_NAME="SIMARC-Arsip Record Center"
APP_URL=http://localhost:8080
APP_PORT=8080
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
SESSION_KEY=simarc-default-key

# ══════════════════════════════════════════════════════════════════
# PostgreSQL Database Configuration
# ══════════════════════════════════════════════════════════════════
# Option 1: Gunakan DATABASE_URL (Neon, Supabase, Railway, dll)
#DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
#
# Option 2: Gunakan DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simarc_db
DB_USERNAME=postgres
DB_PASSWORD=

# ── Google Drive Backup (opsional) ──
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_FOLDER_ID=

# ══════════════════════════════════════════════════════════════════
# VERCEL DEPLOYMENT — Set environment variables ini di Vercel Dashboard
# ══════════════════════════════════════════════════════════════════
# DATABASE_URL=postgresql://neondb_owner:npg_xxxxx@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# SESSION_KEY=random-panjang-string-disini
# APP_URL=https://simarc-anda.vercel.app
# APP_DEBUG=false
