# ===========================================================================
#  SIMARC — Contoh .env untuk KOMPUTER KLIEN (multi-komputer)
#
#  Salin file ini menjadi ".env" di komputer klien, lalu isi alamat server
#  pusat pada SIMARC_SERVER_URL.
#
#  Komputer klien TIDAK menjalankan server dan TIDAK perlu MySQL/database
#  lokal — semua data dan berkas diambil dari server pusat.
#
#  Cara termudah (tulis SIMARC_SERVER_URL otomatis + uji koneksi):
#     Linux / macOS :  ./setup-client.sh
#     Windows       :  powershell -ExecutionPolicy Bypass -File .\setup-client.ps1
# ===========================================================================

# Alamat server pusat (WAJIB diisi). Contoh:
#   http://192.168.1.10:8080     -> di dalam kantor (jaringan LAN)
#   https://arsip.contoh.go.id   -> dari luar kantor (domain + HTTPS atau VPN)
SIMARC_SERVER_URL=

# Tampilan jendela aplikasi: normal | maximized | fullscreen (default) | kiosk
SIMARC_WINDOW=fullscreen

# ---------------------------------------------------------------------------
#  CATATAN PENTING
#  Komputer klien tidak memerlukan pengaturan database. Jangan mengisi
#  DB_* / DATABASE_URL di komputer klien — bila SIMARC_SERVER_URL terisi,
#  aplikasi tidak akan menyambung ke database lokal sama sekali.
# ---------------------------------------------------------------------------
