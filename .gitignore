# ── Build artifacts ──
tmp/
dist/*
/server
/simarc-server
*.exe
*.out
*.test
*.test.exe
# Installer desktop Windows dilacak agar bisa diunduh langsung dari repo
# (pengecualian harus ditulis setelah "*.exe" agar menang).
!dist/SIMARC-Setup.exe

# ── Node / frontend tooling ──
node_modules/

# ── Playwright artifacts ──
test-results/
playwright-report/
blob-report/
.playwright/

# ── Environment ──
.env*
# Izinkan template .env tetap dilacak (contoh untuk server & klien).
!.env.example
!.env.client.example

# ── Runtime storage (regenerated) ──
storage/app/backups/*
storage/app/offsite/
storage/qr-codes/*
public/storage/qr-codes/*
!storage/app/backups/.gitkeep
!storage/app/.gitkeep

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── macOS app bundle symlink ──
SIMARC.app
.vercel

# ── Screenshots / captures (local artifacts) ──
Screenshot_*.png
screen*.png
