# ── Build artifacts ──
tmp/
/server
/simarc-server
*.exe
*.out
*.test
*.test.exe

# ── Desktop (Wails) build output ──
# The packaging assets under desktop/build/ (appicon.png, darwin/, linux/,
# windows/) ARE tracked — they are what produces the per-OS installers. Only
# the compiled binaries and the generated JS bindings are ignored.
desktop/build/bin/
desktop/build/dist/
desktop/frontend/wailsjs/
build/bin/

# ── Node / frontend tooling ──
node_modules/

# ── Environment ──
.env

# ── Runtime storage (regenerated) ──
storage/app/backups/*
storage/qr-codes/*
storage/logs/*
public/storage/qr-codes/*
!storage/app/backups/.gitkeep
!storage/app/.gitkeep

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── macOS app bundle symlink ──
SIMARC.app
.vercel
.env*

# ── Screenshots / captures (local artifacts) ──
Screenshot_*.png
screen*.png

# Playwright artifacts
playwright-report/
test-results/

# Playwright auth state (cookie sesi — jangan pernah commit)
.auth/

# Backup dump SQL lokal (~143 MB) — jangan pernah di-commit/push
simarc-*.sql
